# Copy to backend/.env and fill in.

# PostgreSQL with the pgvector extension (Neon, Supabase, Render all support it)
DATABASE_URL=postgresql+psycopg://noteplify:noteplify@localhost:5432/noteplify

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ENVIRONMENT=development

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Hugging Face access token (https://huggingface.co/settings/tokens) — needs
# "Make calls to Inference Providers" permission.
HF_TOKEN=
HF_PROVIDER=auto
ASR_MODEL=openai/whisper-large-v3
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# true = no AI calls; simulated transcript/notes so you can explore the UI for free
MOCK_AI=false

# hf = Whisper via Inference API, local = faster-whisper on this machine
TRANSCRIBE_BACKEND=hf
ASR_CONCURRENCY=4

# --- Local AI mode (free, offline): pip install -r requirements-local.txt + Ollama ---
# TRANSCRIBE_BACKEND=local
# LOCAL_WHISPER_SIZE=small          # tiny | base | small | medium | large-v3-turbo
# LOCAL_WHISPER_DEVICE=cpu          # cuda needs CUDA 12 + cuDNN 9
# EMBEDDING_BACKEND=local           # fastembed (ONNX), same MiniLM model, 384 dims
# LLM_BACKEND=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# LLM_CONCURRENCY=1                 # one CPU model: don't queue parallel requests
# MAX_CONCURRENT_JOBS=1

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=500
MAX_AUDIO_MINUTES=180
MAX_CONCURRENT_JOBS=2

# Optional: Netscape-format cookies file if YouTube blocks your server's IP
# YTDLP_COOKIES_FILE=/run/secrets/youtube_cookies.txt
